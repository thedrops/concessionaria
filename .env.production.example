NODE_ENV=production

# Dominio final da aplicacao. Exemplo: https://seudominio.com.br
APP_DOMAIN=seudominio.com.br
NEXTAUTH_URL=https://seudominio.com.br
NEXTAUTH_SECRET=troque-por-um-secret-forte

# Banco PostgreSQL local do docker-compose.prod.yml
POSTGRES_USER=concessionaria
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=concessionaria
DATABASE_URL=postgresql://concessionaria:troque-por-uma-senha-forte@db:5432/concessionaria?schema=public
DIRECT_URL=postgresql://concessionaria:troque-por-uma-senha-forte@db:5432/concessionaria?schema=public

# Mantido temporariamente enquanto o codigo ainda consulta imagens antigas do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Futuro storage local persistente.
UPLOAD_STORAGE_DRIVER=local
UPLOADS_DIR=/app/public/uploads
NEXT_PUBLIC_UPLOADS_BASE_URL=/uploads
